# ============================================================
# Egg Billing System — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!
# ============================================================

# --- Supabase PostgreSQL (Transaction Pooler URL — port 6543) ---
# Get from: Supabase Dashboard → Project → Settings → Database → Connection string
# Use "Transaction pooler" for Render (port 6543, not 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- JWT Secret Key (minimum 32 random bytes hex) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex

# --- App Settings ---
ENVIRONMENT=production
ENABLE_DOCS=false

# --- CORS: comma-separated list of your frontend URLs ---
# Add your Vercel/Netlify URL after deployment
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
