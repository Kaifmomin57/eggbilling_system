# Root-level deployment guide env example
# Backend (Render) + Frontend (Vercel) + DB (Supabase)

# --- Set in Render dashboard (Backend env vars) ---
# DATABASE_URL=postgresql://...supabase...
# SECRET_KEY=...
# ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Set in Vercel dashboard (Frontend env vars) ---
# NEXT_PUBLIC_API_URL=https://egg-billing-api.onrender.com/api/v1
